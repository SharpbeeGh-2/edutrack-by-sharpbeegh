# EduTrack by SharpbeeGh, Client Environment Variables
# Copy this file to .env.local and fill in real values.
# Only VITE_-prefixed variables are safe here, they are bundled into the
# client build and are PUBLIC. Server-side secrets go in Supabase Edge
# Function secrets or Vercel project settings, see docs/SECRETS.md.

VITE_APP_NAME="EduTrack by SharpbeeGh"
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_PAYSTACK_PUBLIC_KEY=

VITE_SENTRY_DSN=